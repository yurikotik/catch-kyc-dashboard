# Vercel Blob read/write token
# Create a Blob store in Vercel dashboard -> Storage -> Blob, then copy the token.
# Automatically injected on Vercel once the store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Secret protecting /api/cron/sync-cef.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>"
# when this env var is set on the project. Generate with: openssl rand -hex 32
CRON_SECRET=
